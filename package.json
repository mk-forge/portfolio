		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"wrangler": "^4.151.0"
	},
	"dependencies": {
		"marked": "^18.1.1",
		"overlayscrollbars": "^2.16.0"
	}
